---
layout: null
permalink: /sitemap-images.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{% for p in site.pages %}
  {% assign skip = false %}
  {% if p.sitemap == false %}{% assign skip = true %}{% endif %}
  {% if p.canonical_url %}{% assign skip = true %}{% endif %}
  {% if p.image == nil or p.image == "" %}{% assign skip = true %}{% endif %}
  {% if p.image contains "og-default.png" %}{% assign skip = true %}{% endif %}
  {% if p.image contains "vignettes-themes" %}{% assign skip = true %}{% endif %}
  {% if p.url contains "/brouillons/" %}{% assign skip = true %}{% endif %}
  {% if p.url contains "google2b70f4b4787d43c1" %}{% assign skip = true %}{% endif %}
  {% if p.url == "/sitemap.xml" or p.url == "/sitemap-images.xml" or p.url == "/feed.xml" or p.url == "/404.html" %}{% assign skip = true %}{% endif %}
  {% unless skip %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <image:image>
      <image:loc>{{ p.image | absolute_url }}</image:loc>
      <image:title>{{ p.title | xml_escape }}</image:title>
      {% assign caption = p.cover_alt | default: p.description %}
      {% if caption %}<image:caption>{{ caption | xml_escape }}</image:caption>{% endif %}
    </image:image>
  </url>
  {% endunless %}
{% endfor %}
</urlset>
